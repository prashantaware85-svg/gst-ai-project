{
  "name": "gst-ai-agent-server",
  "version": "1.0.0",
  "description": "GST AI Reconciliation Agent - backend",
"main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx prisma/bootstrap-admin.ts",
    "test": "tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate:prod": "prisma generate --schema prisma/prod/schema.prisma",
    "prisma:migrate:prod": "prisma migrate dev --schema prisma/prod/schema.prisma",
    "prisma:deploy:prod": "prisma migrate deploy --schema prisma/prod/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.56.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "prisma": "^5.18.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4"
  }
}

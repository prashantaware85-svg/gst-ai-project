# ===========================================================================
# GST AI Reconciliation Agent — Server environment
# Copy this file to server/.env and fill in real values. NEVER commit .env.
# ===========================================================================

# --- Core ---
# Port the Express server listens on.
PORT=4000
# Node environment: production / development
NODE_ENV=development

# --- Database ---
# Development / tests use SQLite. Production MUST use PostgreSQL:
#   postgresql://USER:PASSWORD@HOST:5432/gst_agent?connection_limit=10
# Prisma uses this URL for both migrations and queries.
DATABASE_URL="file:./dev.db"
# When deploying to managed Postgres with a pooler (PgBouncer in transaction
# mode), set DATABASE_URL to the pooled URL and DIRECT_URL to the direct
# connection so `prisma migrate deploy` connects to the primary.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/gst_agent"

# --- Security ---
# JWT signing secret. REQUIRED in production, minimum 16 alphanumeric chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-super-secret"

# Comma-separated list of allowed browser origins (no trailing slashes).
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"

# --- AI (optional) ---
# OpenAI API key for natural-language summaries / chat explanations.
# Leave empty to use the deterministic rule-based fallback (fully offline).
OPENAI_API_KEY=""
# Max concurrent AI suggestion calls during a reconciliation run.
AI_CONCURRENCY=5

# --- Storage / files ---
# Where uploaded files and generated report files are written.
UPLOAD_DIR="./uploads"
REPORT_DIR="./reports"
# Optional: absolute path to a pre-built client (client/dist). When omitted,
# the server auto-detects client/dist next to the repo during startup.
# STATIC_DIR="./client/dist"

# --- Reconciliation behaviour ---
# Absolute rupee difference that triggers a "GST difference high" notification.
GST_DIFF_THRESHOLD=50
# Matching tolerances (money in rupees, dates in days, % of larger value).
MATCH_TOLERANCE_RUPEES=1
MATCH_TOLERANCE_PERCENT=0.5
MATCH_DATE_TOLERANCE_DAYS=1

# --- Performance ---
# Prisma connection pool size hint appended to a Postgres DATABASE_URL
# (example: ...?connection_limit=10). Not read as a standalone variable.

# --- Controlled guest login (read-only VIEWER, any environment) ---
# GUEST_AUTH=true lets the frontend auto-login as a read-only VIEWER so the
# login screen is skipped. Works in production too, but that makes GST data
# readable by anyone who opens the site — enable only if acceptable. The guest
# can NEVER reach write endpoints (upload / reconcile / user-creation stay
# ADMIN/ACCOUNTANT-only and return 403). Real-user JWT login is preserved.
# Set GUEST_AUTH=false (or unset) to require a real login again.
GUEST_AUTH=false
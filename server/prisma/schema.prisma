// Prisma schema for the GST AI Reconciliation Agent
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  role     String    @default("VIEWER")
  createdAt DateTime @default(now())

  notifications Notification[]
}

model Upload {
  id        Int       @id @default(autoincrement())
  fileName  String
  source    String
  rows      Int
  filePath String
  createdAt DateTime  @default(now())
}

model Invoice {
  id           Int       @id @default(autoincrement())
  source       String
  gstin        String
  vendorName   String?
  invoiceNo    String
  invoiceDate  DateTime
  taxableValue Float
  cgst         Float     @default(0)
  sgst         Float     @default(0)
  igst         Float     @default(0)
  cess         Float     @default(0)
  totalGst     Float     @default(0)
  invoiceValue Float     @default(0)
  noteType     String?   // "INVOICE" | "CREDIT_NOTE" | "DEBIT_NOTE"
  uploadId     Int?
  createdAt    DateTime  @default(now())

  @@index([source, gstin, invoiceNo])
  @@index([source, gstin])
  @@index([source, invoiceNo])
  @@index([invoiceNo])
  @@index([gstin])
  @@index([invoiceDate])
}

model ReconciliationResult {
  id              Int      @id @default(autoincrement())
  runId           Int
  bookInvoiceId   Int
  twoBInvoiceId   Int?
  status          String
  confidence      Int
  mismatchTypes   String
  bookInvoiceNo   String
  bookGstin       String
  twoBInvoiceNo   String?
  twoBGstin       String?
  vendorName      String?
  bookDate        DateTime?
  twoBDate        DateTime?
  invoiceNoDiff   String?   // human readable diff string for invoice number difference
  dateDiff        String?   // human readable diff string for date difference
  bookTaxable     Float
  twoBTaxable     Float?
  taxableDiff     Float     @default(0)
  bookTax         Float
  twoBTax         Float?
  gstDiff         Float
  itcEligible     Float     @default(0)
  itcPending      Float     @default(0)
  aiWhat          String?
  aiReason        String?
  aiAction        String?
  createdAt       DateTime @default(now())

  @@index([runId])
  @@index([runId, status])
  @@index([runId, bookGstin])
  @@index([runId, twoBGstin])
  @@index([runId, vendorName])
  @@index([runId, bookInvoiceNo])
  @@index([status])
}

model SalesReconciliationResult {
  id             Int      @id @default(autoincrement())
  runId          Int
  salesInvoiceId Int
  gstr1InvoiceId Int?
  status         String
  confidence     Int
  mismatchTypes  String
  bookInvoiceNo  String
  bookGstin      String
  gstr1InvoiceNo String?
  gstr1Gstin     String?
  customerName   String?
  bookDate       DateTime?
  gstr1Date      DateTime?
  invoiceNoDiff  String?
  dateDiff       String?
  bookTaxable    Float
  gstr1Taxable   Float?
  taxableDiff    Float    @default(0)
  bookTax        Float
  gstr1Tax       Float?
  gstDiff        Float    @default(0)
  itcEligible    Float    @default(0)
  itcPending     Float    @default(0)
  aiWhat         String?
  aiReason       String?
  aiAction       String?
  createdAt      DateTime @default(now())

  @@index([runId])
  @@index([runId, status])
  @@index([runId, bookGstin])
  @@index([runId, gstr1Gstin])
  @@index([runId, customerName])
  @@index([runId, bookInvoiceNo])
  @@index([status])
}

model Notification {
  id     Int      @id @default(autoincrement())
  userId Int
  type   String
  title  String
  message String
  read   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}

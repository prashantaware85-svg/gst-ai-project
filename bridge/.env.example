# Tally Bridge configuration (copy this file to bridge/.env and edit it).
# NEVER commit bridge/.env.

# WebSocket endpoint of the deployed backend. HTTPS -> wss. Keep the path.
# Render app URL example:  https://your-app.onrender.com
TALLY_BRIDGE_URL=wss://your-app.onrender.com/ws/bridge

# Must EXACTLY match TALLY_BRIDGE_TOKEN set on the Render server.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TALLY_BRIDGE_TOKEN=change-me

# Optional label for this PC (shows in server logs when multiple bridges run).
TALLY_BRIDGE_DEVICE=default

# TallyPrime XML/HTTP server on THIS PC. Leave as-is unless the port changed.
TALLY_URL=http://localhost:9000